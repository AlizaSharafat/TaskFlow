<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:padding="22dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <TextView
            style="@style/FieldLabel"
            android:text="@string/label_project_name" />

        <EditText
            android:id="@+id/etProjectName"
            style="@style/FieldInput"
            android:hint="@string/hint_project_name"
            android:importantForAutofill="no"
            android:inputType="textCapWords"
            android:maxLines="1" />

        <TextView
            style="@style/FieldLabel"
            android:text="@string/label_project_tag" />

        <EditText
            android:id="@+id/etProjectTag"
            style="@style/FieldInput"
            android:hint="@string/hint_project_tag"
            android:importantForAutofill="no"
            android:inputType="textCapWords"
            android:maxLines="1" />

        <TextView
            style="@style/FieldLabel"
            android:text="@string/label_attachment" />

        <EditText
            android:id="@+id/etAttachment"
            style="@style/FieldInput"
            android:hint="@string/hint_attachment"
            android:importantForAutofill="no"
            android:inputType="text"
            android:maxLines="1" />

        <TextView
            style="@style/FieldLabel"
            android:text="@string/label_project_description" />

        <EditText
            android:id="@+id/etProjectDescription"
            style="@style/FieldInput"
            android:gravity="top"
            android:hint="@string/hint_project_description"
            android:importantForAutofill="no"
            android:inputType="textMultiLine"
            android:minLines="4" />

        <Button
            android:id="@+id/btnAddProject"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:background="@drawable/bg_button_dark"
            android:paddingTop="14dp"
            android:paddingBottom="14dp"
            android:text="@string/add_project"
            android:textAllCaps="false"
            android:textColor="@color/white"
            android:textSize="15sp" />
    </LinearLayout>
</ScrollView>
