<?xml version="1.0" encoding="utf-8"?>
<!--
    A section heading inside the task list.

    This is the second of the two row layouts the single TaskAdapter inflates.
    It deliberately has no card background and no checkbox: it is a label, and
    the touch callback gives it no swipe or drag flags at all, so it cannot be
    dragged out of place or swiped away.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="6dp"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:paddingStart="2dp"
    android:paddingTop="10dp"
    android:paddingEnd="2dp"
    android:paddingBottom="6dp">

    <ImageView
        android:id="@+id/ivGroupDot"
        android:layout_width="9dp"
        android:layout_height="9dp"
        android:contentDescription="@null" />

    <TextView
        android:id="@+id/tvGroupName"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="8dp"
        android:layout_weight="1"
        android:textAllCaps="true"
        android:textColor="@color/ink_soft"
        android:textSize="12sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/tvGroupCount"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_pill_light"
        android:gravity="center"
        android:minWidth="26dp"
        android:paddingStart="8dp"
        android:paddingTop="2dp"
        android:paddingEnd="8dp"
        android:paddingBottom="2dp"
        android:textColor="@color/ink_soft"
        android:textSize="11sp"
        android:textStyle="bold" />
</LinearLayout>
