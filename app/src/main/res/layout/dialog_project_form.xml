<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:padding="22dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <TextView
            android:id="@+id/tvDialogTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"
            android:textColor="@color/ink"
            android:textSize="18sp"
            android:textStyle="bold" />

        <TextView
            style="@style/FieldLabel"
            android:text="@string/label_project_name" />

        <EditText
            android:id="@+id/etProjectName"
            style="@style/FieldInput"
            android:hint="@string/hint_project_name"
            android:importantForAutofill="no"
            android:inputType="textCapWords"
            android:maxLength="60"
            android:maxLines="1" />

        <TextView
            style="@style/FieldLabel"
            android:text="@string/label_project_tag" />

        <EditText
            android:id="@+id/etProjectTag"
            style="@style/FieldInput"
            android:hint="@string/hint_project_tag"
            android:importantForAutofill="no"
            android:inputType="textCapWords"
            android:maxLength="20"
            android:maxLines="1" />

        <TextView
            style="@style/FieldLabel"
            android:text="@string/label_project_description" />

        <EditText
            android:id="@+id/etProjectDescription"
            style="@style/FieldInput"
            android:gravity="top"
            android:hint="@string/hint_project_description"
            android:importantForAutofill="no"
            android:inputType="textMultiLine"
            android:maxLength="500"
            android:minLines="3" />

        <TextView
            style="@style/FieldLabel"
            android:text="@string/label_attachment" />

        <LinearLayout
            android:id="@+id/attachmentRow"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="18dp"
            android:background="@drawable/bg_input"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:padding="14dp">

            <ImageView
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:contentDescription="@null"
                android:src="@drawable/ic_clip" />

            <TextView
                android:id="@+id/tvSelectedAttachment"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="10dp"
                android:layout_weight="1"
                android:ellipsize="end"
                android:maxLines="1"
                android:text="@string/no_attachment_selected"
                android:textColor="@color/ink_soft"
                android:textSize="14sp" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <androidx.appcompat.widget.AppCompatButton
                android:id="@+id/btnCancelProject"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginEnd="6dp"
                android:layout_weight="1"
                android:background="@drawable/bg_pill_light"
                android:paddingTop="14dp"
                android:paddingBottom="14dp"
                android:text="@string/cancel"
                android:textAllCaps="false"
                android:textColor="@color/ink"
                android:textSize="15sp" />

            <androidx.appcompat.widget.AppCompatButton
                android:id="@+id/btnSaveProject"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="6dp"
                android:layout_weight="1"
                android:background="@drawable/bg_button_dark"
                android:paddingTop="14dp"
                android:paddingBottom="14dp"
                android:textAllCaps="false"
                android:textColor="@color/white"
                android:textSize="15sp" />
        </LinearLayout>
    </LinearLayout>
</ScrollView>
